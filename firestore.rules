rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Authenticated admin users සඳහා පමණක් Read/Write - collections තුන සඳහාම එකම රීතිය
    match /teachers/{nic} {
      allow read, write: if request.auth != null;
    }

    match /students/{admissionNo} {
      allow read, write: if request.auth != null;
    }

    match /marksheets/{sheetId} {
      allow read, write: if request.auth != null;
    }

    // වෙනත් සියලුම collections වලට access අවහිර කරන්න
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
